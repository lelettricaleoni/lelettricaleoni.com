# Runtime variables of one environment: copy to ~/docker/web/staging.env or production.env on the VM (mode 600)
# and fill in. Names only, no values: the real ones never go in git.
#
# The NEXT_PUBLIC_* values are baked into the image at build time (see .github/workflows/deploy.yml); only the
# two the server also reads at runtime are repeated here. APP_ENV and APP_VERSION are set by deploy.sh.
#
# staging uses the development Supabase project and bucket, production the real ones: never mix them.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase: transaction pooler, port 6543 (lib/db/pooler.ts corrects the port anyway)
DATABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Cloudflare R2 (photos, GPX, video)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
# Read-only token for /manage/dev statistics
CLOUDFLARE_API_TOKEN=

# Upstash Redis: read cache and transcoding state
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

AZURE_TRANSLATOR_ENDPOINT=
AZURE_TRANSLATOR_REGION=
AZURE_TRANSLATOR_KEY=
CARTO_API_KEY=

# 32 random bytes, base64 (openssl rand -base64 32). Losing it makes the saved integration credentials unreadable.
INTEGRATIONS_ENCRYPTION_KEY=
# Shared secret of run-cron.sh and /api/cron/google-calendar (openssl rand -hex 32)
CRON_SECRET=
