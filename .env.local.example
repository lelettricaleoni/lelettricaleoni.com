# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://[project-ref].supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=[anon-key]
SUPABASE_SERVICE_ROLE_KEY=[service-role-key]

# Drizzle / Postgres
DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true
DATABASE_DIRECT_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres

# Cloudflare R2
R2_ACCOUNT_ID=[cloudflare-account-id]
R2_ACCESS_KEY_ID=[r2-access-key]
R2_SECRET_ACCESS_KEY=[r2-secret-key]
R2_BUCKET_NAME=lelettrica-trails
NEXT_PUBLIC_R2_PUBLIC_URL=https://pub-[hash].r2.dev

# Azure Translator
AZURE_TRANSLATOR_KEY=[key]
AZURE_TRANSLATOR_REGION=westeurope
AZURE_TRANSLATOR_ENDPOINT=https://api.cognitive.microsofttranslator.com

# Cesium ion — token gratuito da https://ion.cesium.com (necessario per terreno 3D nel flyover)
NEXT_PUBLIC_CESIUM_TOKEN=[cesium-ion-access-token]

# CARTO basemaps — API key gratuita da https://carto.com/basemaps/apikey (server-only, usata dal proxy /api/map-tile)
CARTO_API_KEY=[carto-api-key]

# MinIO (video storage)
MINIO_ENDPOINT=https://cluster-bucket.kevinleoni.org
MINIO_ACCESS_KEY_ID=
MINIO_SECRET_ACCESS_KEY=
MINIO_BUCKET_NAME=lelettricaleoni.com
NEXT_PUBLIC_MINIO_PUBLIC_URL=https://cluster-bucket.kevinleoni.org/lelettricaleoni.com

# Feature flags — la sorgente dei valori e' Vercel Flags (dashboard del progetto,
# sezione Flags). Le chiavi sono: routes, route-photos, route-videos,
# route-flyover, route-gpx-download. Cambiarli li' ha effetto senza redeploy.
#
# Le variabili qui sotto sono solo un OVERRIDE DI SVILUPPO, ignorato in
# produzione: servono a lavorare e a far girare i test senza rete, quando la
# macchina non ha il token OIDC. Spengono con off/0/false/no, accendono con
# on/1/true/yes; qualsiasi altro valore non sovrascrive nulla.
#
# Per valutare i flag veri in locale serve il token OIDC. Scaricalo FUORI dal
# progetto e copia la sola riga VERCEL_OIDC_TOKEN in .env.development.local,
# che Next carica dopo .env.local:
#   vercel env pull /percorso/fuori/dal/progetto/vercel.env --yes
# NON lanciare `vercel env pull .env.local`: sovrascrive il file e perdi le
# chiavi R2, MinIO e Azure. Il token scade dopo circa 12 ore.
#
# FEATURE_ROUTES=off
# FEATURE_ROUTE_PHOTOS=off
# FEATURE_ROUTE_VIDEOS=off
# FEATURE_ROUTE_FLYOVER=off
# FEATURE_ROUTE_GPX_DOWNLOAD=off
